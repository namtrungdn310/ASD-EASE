  "target_scenarios": [
    {
      "id": "C01",
      "steps": [
        "state_request",
        "start_http",
        "command_start",
        "ack_started",
        "state_ack_request",
        "state_confirmed"
      ],
      "assert": "Chỉ một epoch; xác nhận sau lưu ACK ứng dụng. PUBACK không tự thành RECORDING."
    },
    {
      "id": "C02",
      "steps": [
        "raw_full",
        "raw_duplicate",
        "raw_conflict"
      ],
      "assert": "Lần đầu202, trùng202, xung đột409; chỉ tăng số đã lưu một lần."
    },
    {
      "id": "C03",
      "steps": [
        "ack_stopped",
        "raw_final_partial",
        "raw_full"
      ],
      "assert": "Tổng kết trước/sau raw và raw sai thứ tự đều cho cùng kết quả đủ/thiếu."
    },
    {
      "id": "C04",
      "steps": [
        "command_start",
        "command_start",
        "ack_started",
        "ack_started"
      ],
      "assert": "Lặp lệnh/ACK không đặt lại epoch, nhân đôi phiên hoặc sự kiện."
    },
    {
      "id": "C05",
      "assert": "Stop generation2 thay Start1; ACK1 muộn không trở lại RECORDING."
    },
    {
      "id": "C06",
      "assert": "Từ chối lệnh cũ, hết thời hạn, sai request/kết nối/boot; presence không chứng minh live."
    },
    {
      "id": "C07",
      "assert": "Reboot đánh gián đoạn phiên cũ, không ghép clock mới vào bản ghi cũ."
    },
    {
      "id": "C08",
      "assert": "Lỗi sau commit trước publish phục hồi cùng lệnh; ACK chưa commit được thử lại qua state request."
    },
    {
      "id": "C09",
      "assert": "Broker lỗi/HTTP còn thì gửi nốt phiên hợp lệ; HTTP raw lỗi/MQTT còn thì báo mất và không đủ."
    },
    {
      "id": "C10",
      "assert": "Thiếu batch cuối hoặc tổng kết thì hết hạn có kiểm soát, không báo đủ sai."
    },
