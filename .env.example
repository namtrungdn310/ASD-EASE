# Mẫu phát triển local; đọc docs/LOCAL_SETUP.md trước khi chép.
# Backend: chép thành backend/.env, chạy Uvicorn từ backend/.
DATABASE_URL=sqlite:///./storage/asd_edge_ai.db
RAW_STORAGE_DIR=./storage/raw
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend: đặt hai giá trị dưới trong frontend/.env.local cho Vite trực tiếp.
# VITE_* công khai và được nhúng khi build, không chứa secret.
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/api/v1/ws/live

# Docker Compose đặt đường DB/lưu trữ và tham số build Vite
# trong compose.yaml; .env ở root không tự ghi đè các giá trị này.
# Giữ Wi-Fi credential trong network_config.h local đã bị Git bỏ qua.
