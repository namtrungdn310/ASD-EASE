# Local-development template. See docs/LOCAL_SETUP.md before copying.
# Backend: copy this file to backend/.env and run Uvicorn from backend/.
DATABASE_URL=sqlite:///./storage/asd_edge_ai.db
RAW_STORAGE_DIR=./storage/raw
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend: put these two values in frontend/.env.local for native Vite.
# VITE_* values are public and are embedded during the frontend build.
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/api/v1/ws/live

# Docker Compose currently sets its own database/storage paths and Vite build
# arguments in compose.yaml. A root .env alone does not override those values.
# Keep Wi-Fi credentials only in the ignored firmware network_config.h.
